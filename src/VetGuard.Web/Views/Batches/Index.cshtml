@model BatchesIndexViewModel
@{
    ViewData["Title"] = "Контроль партий продукции и Карантинный замок";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Ветеринарно-санитарная экспертиза сырья</p>
        <h1>Контроль товарных партий и жесткий «Карантинный замок»</h1>
        <p class="page-description">Транзакционная проверка каждого животного перед включением в танк молока или партию на отгрузку с защитой от гонок <code>SQL rowversion</code>.</p>
    </div>
    <div class="header-actions">
        <form asp-action="TriggerDemoQuarantineTest"
              method="post"
              hx-post="@Url.Action("TriggerDemoQuarantineTest", "Batches")"
              hx-target="#batch-outcome-zone"
              hx-swap="innerHTML">
            <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                ⚡ Демо-тест: Попытаться сдать карантинное молоко (Зорька-4)
            </button>
        </form>
    </div>
</header>

<!-- Зона результата проверки карантинного замка (HTMX или POST) -->
<div id="batch-outcome-zone" class="mb-4">
    @if (Model.LastOutcome is not null)
    {
        @await Html.PartialAsync("_BatchOutcomeBanner", Model.LastOutcome)
    }
</div>

<div class="row g-4 mb-4">
    <!-- Левая панель: Формирование новой товарной партии -->
    <div class="col-lg-6">
        <div class="vg-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Формирование товарной партии</h5>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="selectOnlySafeCows()">
                    ✓ Отметить только здоровых коров
                </button>
            </div>

            <form asp-action="Create" method="post">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Номер партии *</label>
                        <input type="text" name="batchNumber" value="@Model.SuggestedBatchNumber" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Тип продукции *</label>
                        <select name="batchType" id="batchTypeSelect" class="form-select form-select-sm">
                            <option value="@ProductBatchType.RawMilk">🥛 Товарное молоко (молзавод)</option>
                            <option value="@ProductBatchType.MeatSlaughter">🥩 Партия на убой / отгрузку</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-semibold">Получатель (Переработчик) *</label>
                        <input type="text" name="destination" value="АО «Янтарь» (Иркутский молочный завод)" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label small fw-semibold">Жир (%)</label>
                        <input type="number" step="0.01" name="fatPercent" value="3.98" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small fw-semibold">Белок (%)</label>
                        <input type="number" step="0.01" name="proteinPercent" value="3.32" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small fw-semibold">Соматика (тыс.)</label>
                        <input type="number" name="somaticCellsThousands" value="138" class="form-control form-control-sm" />
                    </div>
                </div>

                <label class="form-label small fw-bold mb-2">Состав животных для включения в партию (попробуйте отметить корову под замком 🔒):</label>
                <div class="border rounded-3 p-2 mb-3" style="max-height: 310px; overflow-y: auto; border-color: var(--vg-border) !important;">
                    @foreach (var a in Model.HerdAnimals.Where(x => x.Sex == AnimalSex.Female || x.CurrentWeightKg > 300))
                    {
                        var isLocked = a.IsMilkQuarantineLocked || a.IsMeatQuarantineLocked || a.HealthStatus == HealthStatus.Quarantine;
                        var defaultQty = a.AverageDailyMilkKg ?? 26.0m;
                        var isHealthyMilker = a.Sex == AnimalSex.Female && !isLocked && a.AverageDailyMilkKg.HasValue;
                        <div class="d-flex align-items-center justify-content-between py-1 px-2 rounded mb-1 @(isLocked ? "border border-danger border-opacity-50" : "")"
                             style="background: @(isLocked ? "var(--vg-danger-soft)" : "transparent");">
                            <div class="form-check">
                                <input class="form-check-input batch-cow-check"
                                       type="checkbox"
                                       name="selectedAnimalIds"
                                       value="@a.Id"
                                       data-safe-milker="@(isHealthyMilker ? "1" : "0")"
                                       checked="@isHealthyMilker"
                                       id="chk_@a.Id" />
                                <label class="form-check-label small" for="chk_@a.Id">
                                    <strong>@a.Name</strong> <span class="font-monospace text-muted">[@a.TagNumber]</span>
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger ms-1">
                                            🔒 ЗАМОК: @a.ActiveLockDrugName (@(a.RemainingMilkLockHours > 0 ? $"{Math.Ceiling(a.RemainingMilkLockHours)} ч" : "Изолятор"))
                                        </span>
                                    }
                                    else if (a.Sex == AnimalSex.Male)
                                    {
                                        <span class="badge bg-secondary ms-1">♂ Бык (только отгрузка)</span>
                                    }
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-1" style="width: 110px;">
                                <input type="number" step="0.1" name="quantities[@a.Id]"
                                       value="@defaultQty.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control form-control-sm text-end" />
                                <span class="small text-muted">л</span>
                            </div>
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-vg-primary w-100 py-2">
                    Проверить «Карантинный замок» и сформировать товарную партию
                </button>
            </form>
        </div>
    </div>

    <!-- Правая панель: Реестр партий + Допуск ветврача (RowVersion) -->
    <div class="col-lg-6">
        <div class="vg-card mb-4">
            <div class="vg-card-header">
                <h5 class="fw-bold mb-0">Реестр партий продукции (Optimistic Concurrency)</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Партия / Получатель</th>
                            <th>Объем</th>
                            <th>Статус ВСД</th>
                            <th class="pe-3 text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Batches)
                        {
                            var unit = b.BatchType == ProductBatchType.RawMilk ? "л" : "кг";
                            <tr>
                                <td class="ps-3 small">
                                    <div class="fw-bold font-monospace">@b.BatchNumber</div>
                                    <div class="text-muted">@b.Destination</div>
                                    <div class="text-muted">Голов в партии: @b.Items.Count</div>
                                </td>
                                <td class="fw-bold">
                                    @b.TotalVolumeLitersOrKg.ToString("0.0") @unit
                                </td>
                                <td>
                                    @if (b.Status == BatchStatus.Approved || b.Status == BatchStatus.Shipped)
                                    {
                                        <span class="vg-badge-healthy">@b.Status.ToDisplayName()</span>
                                        <div class="small text-muted mt-1">@b.ApprovedByVeterinarian</div>
                                    }
                                    else
                                    {
                                        <span class="vg-badge-treatment">@b.Status.ToDisplayName()</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="d-flex justify-content-end gap-1 flex-wrap">
                                        @if (b.Status == BatchStatus.Draft)
                                        {
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden" name="batchId" value="@b.Id" />
                                                <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(b.RowVersion)" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold">✓ Допустить (ВСД)</button>
                                            </form>
                                        }
                                        else if (b.Status == BatchStatus.Approved)
                                        {
                                            <form asp-action="Ship" method="post">
                                                <input type="hidden" name="batchId" value="@b.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">🚚 Отгрузить</button>
                                            </form>
                                        }
                                        <a asp-action="CertificatePdf" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary" title="Скачать ветеринарную справку PDF">
                                            PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Журнал перехваченных попыток сдачи карантинного сырья -->
        <div class="vg-card">
            <div class="vg-card-header">
                <h6 class="fw-bold mb-0 text-danger">🚨 Журнал заблокированных попыток сдачи карантинной продукции</h6>
            </div>
            <div class="p-3" style="max-height: 290px; overflow-y: auto;">
                @foreach (var log in Model.BlockedLogs)
                {
                    <div class="p-2 mb-2 rounded border border-danger border-opacity-50 small" style="background: var(--vg-danger-soft);">
                        <div class="d-flex justify-content-between fw-bold text-danger">
                            <span>Партия @log.AttemptedBatchNumber • @log.AnimalName [@log.AnimalTag]</span>
                            <span>@log.AttemptedAtUtc.AddHours(8).ToString("dd.MM HH:mm:ss")</span>
                        </div>
                        <div>@log.BlockMessage</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectOnlySafeCows() {
            document.querySelectorAll(".batch-cow-check").forEach(function (chk) {
                chk.checked = chk.getAttribute("data-safe-milker") === "1";
            });
        }
    </script>
}
