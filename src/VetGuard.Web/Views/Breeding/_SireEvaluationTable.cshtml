@model IReadOnlyList<CandidateSireEvaluationDto>
@{
    var damId = ViewBag.DamId is Guid g ? g : Guid.Empty;
}

<div class="table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th class="ps-3">Бык-производитель (♂)</th>
                <th>Коэффициент Райта (F_X)</th>
                <th>Оценка риска</th>
                <th>Шкала Шапоружа & Общие предки (T-SQL CTE)</th>
                <th>Зоотехническое заключение</th>
                <th class="pe-3 text-end">План случки</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                var rowHighlight = c.RiskLevel switch
                {
                    InbreedingRiskLevel.Critical => "background: var(--vg-danger-soft);",
                    InbreedingRiskLevel.High => "background: var(--vg-warning-soft);",
                    _ => ""
                };
                <tr style="@rowHighlight">
                    <td class="ps-3">
                        <a asp-controller="Animals" asp-action="Details" asp-route-id="@c.SireId" class="fw-bold text-decoration-none">
                            ♂ @c.SireName
                        </a>
                        <div class="small font-monospace text-muted">@c.SireTag</div>
                        <div class="small text-muted">@c.SireBreed • @(c.SireLineage ?? "—")</div>
                    </td>
                    <td>
                        <span class="fs-5 fw-bold @(c.RiskLevel == InbreedingRiskLevel.Safe ? "text-success" : c.RiskLevel == InbreedingRiskLevel.Moderate ? "text-warning" : "text-danger")">
                            @c.InbreedingPercent.ToString("0.00")%
                        </span>
                    </td>
                    <td>
                        @if (c.RiskLevel == InbreedingRiskLevel.Safe)
                        {
                            <span class="vg-badge-healthy">🟢 @c.RiskLevel.ToDisplayName()</span>
                        }
                        else if (c.RiskLevel == InbreedingRiskLevel.Moderate)
                        {
                            <span class="vg-badge-treatment">🟡 @c.RiskLevel.ToDisplayName()</span>
                        }
                        else if (c.RiskLevel == InbreedingRiskLevel.High)
                        {
                            <span class="vg-badge-treatment" style="border-color:#ea580c;color:#ea580c;">🟠 @c.RiskLevel.ToDisplayName()</span>
                        }
                        else
                        {
                            <span class="vg-badge-quarantine">🔴 @c.RiskLevel.ToDisplayName()</span>
                        }
                    </td>
                    <td class="small">
                        <div class="fw-bold">@c.ShaporuzhSummary</div>
                        @if (c.CommonAncestors.Count > 0)
                        {
                            <ul class="mb-0 ps-3 mt-1 text-muted">
                                @foreach (var anc in c.CommonAncestors)
                                {
                                    <li>
                                        <strong>@anc.AncestorName</strong> [@anc.AncestorTag] — ряд <strong>@anc.ShaporuzhDegree</strong> (+@anc.ContributionPercent.ToString("0.00")%)
                                    </li>
                                }
                            </ul>
                        }
                    </td>
                    <td class="small" style="max-width: 310px;">
                        @c.Recommendation
                    </td>
                    <td class="pe-3 text-end">
                        @if (c.RiskLevel == InbreedingRiskLevel.Critical)
                        {
                            <form asp-controller="Breeding" asp-action="SavePlan" method="post">
                                <input type="hidden" name="DamId" value="@damId" />
                                <input type="hidden" name="SireId" value="@c.SireId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Попытка закрепить кровосмесительную пару вызовет доменный запрет">
                                    ⛔ Заблокировано
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Breeding" asp-action="SavePlan" method="post">
                                <input type="hidden" name="DamId" value="@damId" />
                                <input type="hidden" name="SireId" value="@c.SireId" />
                                <button type="submit" class="btn btn-sm btn-vg-primary">
                                    ✓ Закрепить пару
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
