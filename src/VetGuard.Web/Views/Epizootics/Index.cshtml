@model EpizooticsIndexViewModel
@{
    ViewData["Title"] = "Противоэпизоотический календарь и Карантинный изолятор";
    var createdActId = TempData["CreatedActId"] as string;
}

<header class="page-header">
    <div>
        <p class="eyebrow">Государственный противоэпизоотический надзор</p>
        <h1>Противоэпизоотический план и Карантинный изолятор</h1>
        <p class="page-description">Автоматический контроль сроков обязательных вакцинаций и исследований (сибирская язва, туберкулинизация, бруцеллёз, лейкоз), групповая обработка в 2 клика и генерация PDF-актов.</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(createdActId) && Guid.TryParse(createdActId, out var newActGuid))
    {
        <div class="header-actions">
            <a asp-action="ActPdf" asp-route-id="@newActGuid" class="btn btn-primary">
                🖨️ Скачать созданный PDF-Акт обработки
            </a>
        </div>
    }
</header>

<!-- 1. Обязательный противоэпизоотический план по возрасту и срокам ревакцинации -->
<div class="row g-4 mb-4">
    @foreach (var plan in Model.Plans)
    {
        var overdueCount = plan.ActionRequiredAnimals.Count(a => a.State == EpizooticComplianceState.Overdue);
        var dueSoonCount = plan.ActionRequiredAnimals.Count(a => a.State == EpizooticComplianceState.DueSoon);
        <div class="col-lg-6">
            <div class="vg-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="vg-card-header">
                        <div>
                            <span class="badge bg-secondary bg-opacity-10 text-body border mb-1">@plan.EventType.ToDisplayName()</span>
                            <h6 class="fw-bold mb-0">@plan.Title</h6>
                        </div>
                        @if (plan.ActionRequiredAnimals.Count > 0)
                        {
                            <!-- 1-й клик групповой обработки -->
                            <button type="button"
                                    class="btn btn-sm btn-vg-primary text-nowrap"
                                    hx-get="@Url.Action("PrepareGroupModal", "Epizootics", new { ruleId = plan.RuleId })"
                                    hx-target="#vg-modal-content"
                                    hx-swap="innerHTML">
                                ⚡ Групповая обработка (@plan.ActionRequiredAnimals.Count гол.)
                            </button>
                        }
                        else
                        {
                            <span class="vg-badge-healthy">✓ План выполнен 100%</span>
                        }
                    </div>

                    <div class="p-3 small">
                        <div class="text-muted mb-2">
                            <strong>Основание:</strong> @plan.RegulatoryBasis<br />
                            <strong>Возрастной ценз:</strong> с @(plan.MinAgeDays / 30) мес. (@plan.MinAgeDays дн.) •
                            <strong>Интервал:</strong> каждые @plan.IntervalDays сут.<br />
                            <strong>Биопрепарат:</strong> @(plan.DefaultDrugName ?? "—") (серия <code>@plan.DefaultDrugSeries</code>, запас: <strong>@plan.AvailableStock.ToString("0")</strong>)
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <span class="vg-badge-healthy">Привито/Исследовано: @plan.CompliantAnimalsCount</span>
                            @if (overdueCount > 0)
                            {
                                <span class="vg-badge-quarantine">Требуют обработки: @overdueCount</span>
                            }
                            @if (dueSoonCount > 0)
                            {
                                <span class="vg-badge-treatment">В ближайшие 14 дн.: @dueSoonCount</span>
                            }
                        </div>

                        @if (plan.ActionRequiredAnimals.Count > 0)
                        {
                            <div class="border rounded p-2 mt-2" style="max-height: 155px; overflow-y: auto; border-color: var(--vg-border) !important;">
                                @foreach (var item in plan.ActionRequiredAnimals)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color: var(--vg-border) !important;">
                                        <span>
                                            <strong>@item.Name</strong> <span class="font-monospace text-muted">[@item.TagNumber]</span>
                                            <span class="text-muted">(@item.BarnName)</span>
                                        </span>
                                        <span class="@(item.State == EpizooticComplianceState.Overdue ? "text-danger fw-bold" : "text-warning fw-semibold")">
                                            @(item.LastExecutedAtUtc.HasValue ? $"истек {item.DueAtUtc:dd.MM}" : "первичная")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 2. Карантинный изолятор и Архив официальных актов -->
<div class="row g-4">
    <div class="col-lg-5">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h5 class="fw-bold mb-0 text-danger">🚨 Боксы карантинного изолятора</h5>
            </div>
            <div class="p-3">
                @if (Model.IsolatorAnimals.Count == 0)
                {
                    <div class="text-muted small py-3 text-center">Боксы изолятора свободны.</div>
                }
                else
                {
                    @foreach (var iso in Model.IsolatorAnimals)
                    {
                        var daysInIso = iso.QuarantineEnteredAtUtc.HasValue
                            ? Math.Max(1, (int)(DateTime.UtcNow - iso.QuarantineEnteredAtUtc.Value).TotalDays)
                            : 1;
                        var pct = Math.Min(100, (int)Math.Round(daysInIso / 30.0 * 100));
                        <div class="p-3 rounded-3 border border-danger border-opacity-50 mb-3" style="background: var(--vg-danger-soft);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <a asp-controller="Animals" asp-action="Details" asp-route-id="@iso.Id" class="fw-bold text-danger text-decoration-none">
                                    @iso.Name [@iso.TagNumber]
                                </a>
                                <span class="badge bg-danger">@iso.SectionCode</span>
                            </div>
                            <div class="small mb-2">@iso.QuarantineReason</div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Срок 30-дневного карантина: @daysInIso из 30 сут.</span>
                                <span>@pct%</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-danger" style="width: @(pct)%;"></div>
                            </div>
                            <form asp-controller="Animals" asp-action="Release" method="post" class="text-end">
                                <input type="hidden" name="animalId" value="@iso.Id" />
                                <input type="hidden" name="returnToEpizootics" value="1" />
                                <button type="submit" class="btn btn-sm btn-success">✓ Снять карантин и перевести в стадо</button>
                            </form>
                        </div>
                    }
                }

                <hr />
                <h6 class="fw-bold small mb-2">Поместить животное в карантинный изолятор</h6>
                <form asp-action="IsolateAnimal" method="post" class="row g-2">
                    <div class="col-md-6">
                        <select name="animalId" class="form-select form-select-sm" required>
                            @foreach (var a in Model.NonIsolatedAnimals)
                            {
                                <option value="@a.Id">@a.Name [@a.TagNumber]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input type="text" name="isolatorBox" value="Бокс №3 (Диагностический)" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-12">
                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Причина изоляции (сомнительная реакция / температурящее животное)..." required />
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Перевести в изолятор</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Реестр оформленных актов противоэпизоотических обработок с экспортом в PDF -->
    <div class="col-lg-7">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h5 class="fw-bold mb-0">📄 Оформленные акты противоэпизоотических обработок</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Номер акта / Дата</th>
                            <th>Мероприятие / Биопрепарат</th>
                            <th>Голов / Расход</th>
                            <th class="pe-3 text-end">Экспорт</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in Model.RecentActs)
                        {
                            <tr>
                                <td class="ps-3 small">
                                    <div class="fw-bold font-monospace">@act.ActNumber</div>
                                    <div class="text-muted">@act.ExecutedAtUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm")</div>
                                </td>
                                <td class="small">
                                    <div class="fw-semibold">@(act.EpizooticRule?.Title ?? "Обработка")</div>
                                    <div class="text-muted">@act.DrugNameSnapshot (серия @act.DrugSeriesSnapshot)</div>
                                </td>
                                <td class="small">
                                    <strong>@act.Items.Count гол.</strong>
                                    <div class="text-muted">@act.TotalDosesUsed.ToString("0.#") доз</div>
                                </td>
                                <td class="pe-3 text-end">
                                    <a asp-action="ActPdf" asp-route-id="@act.Id" class="btn btn-sm btn-vg-primary">
                                        🖨️ Акт PDF
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
