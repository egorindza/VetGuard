@model IReadOnlyList<DemoUserProfile>
@{
    ViewData["Title"] = "Демо-вход по ролям";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<header class="page-header">
    <div>
        <p class="eyebrow">Аутентификация и ролевой контур ИрГАУ</p>
        <h1>Быстрый демо-вход по рабочим местам</h1>
        <p class="page-description">Выберите профиль специалиста учебно-опытного хозяйства для мгновенного входа в 1 клик и фиксации авторства ветеринарных обработок, актов и партий.</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="header-actions">
            <form asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-secondary">Завершить текущую сессию</button>
            </form>
        </div>
    }
</header>

<div class="row g-4">
    @foreach (var profile in Model)
    {
        var isCurrent = User.IsInRole(profile.Role);
        <div class="col-md-4">
            <div class="panel h-100 d-flex flex-column justify-content-between @(isCurrent ? "preview-highlight" : "")">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-2">@profile.BadgeIcon</span>
                        @if (isCurrent)
                        {
                            <span class="agro-badge">Активный пост</span>
                        }
                    </div>
                    <p class="eyebrow mb-1">@profile.Department</p>
                    <h2 class="h5 fw-bold mb-1">@profile.RoleTitle</h2>
                    <div class="small fw-semibold mb-2">@profile.FullName</div>
                    <p class="small text-muted mb-4">@profile.Description</p>
                </div>

                <form asp-action="DemoLogin" method="post">
                    <input type="hidden" name="roleKey" value="@profile.Key" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-primary w-100">
                        Войти как «@profile.RoleTitle» →
                    </button>
                </form>
            </div>
        </div>
    }
</div>
